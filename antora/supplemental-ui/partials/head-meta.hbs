<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{{detag (or page.title defaultPageTitle)}}}{{#with site.title}} :: {{this}}{{/with}}</title>
  {{#if page.canonicalUrl}}<link rel="canonical" href="{{page.canonicalUrl}}">{{/if}}
  {{#if page.previousPage}}<link rel="prev" href="{{page.previousPage.pub.url}}">{{/if}}
  {{#if page.nextPage}}<link rel="next" href="{{page.nextPage.pub.url}}">{{/if}}
  <meta name="generator" content="Antora {{antoraVersion}}">
  <script>
!function (theme, navWidth) {
  if (theme === 'dark') document.documentElement.classList.add('dark-theme')
  if (navWidth) document.documentElement.style.setProperty('--nav-width', `${navWidth}px`)
}(localStorage && localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)')?.matches && 'dark'),
  localStorage && localStorage.getItem('nav-width'))
  </script>
  <link rel="stylesheet" href="{{uiRootPath}}/css/site.css">
  <link rel="stylesheet" href="{{uiRootPath}}/css/vendor/search.css">
  <link rel="stylesheet" href="{{uiRootPath}}/css/vendor/page-search.css">
  <link rel="stylesheet" href="{{uiRootPath}}/css/vendor/spring-tabs.css">
  {{#if page.attributes.page-description}}<meta name="description" content="{{page.attributes.page-description}}">{{/if}}
  <meta name="antora-ui-version" content="{{antoraUiVersion}}">
  <meta name="version" content="{{page.version}}">
  <meta name="component" content="{{page.component.name}}">
  <meta name="latest-version" content="{{page.component.latest.version}}">
  <link rel="icon" href="{{uiRootPath}}/img/favicon.ico" type="image/x-icon">
  <link rel="shortcut icon" href="{{uiRootPath}}/img/favicon.ico">
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    var title = document.querySelector('h2');
    if (title && document.title.startsWith('Untitled')) {
      document.title = title.textContent.trim() + '{{#with site.title}} :: {{this}}{{/with}}';
    }
  });
  </script>
  <link rel="stylesheet" href="{{uiRootPath}}/css/extra.css">
</head>